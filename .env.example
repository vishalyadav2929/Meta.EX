# --- Meta ---
META_ACCESS_TOKEN=            # System user / long-lived token with ads_management, ads_read, pages_show_list, business_management
META_API_VERSION=v25.0        # check developers.facebook.com for the current version
META_AD_ACCOUNT_ID=           # e.g. act_1234567890
# LEAD_ACTION_TYPES=onsite_conversion.messaging_conversation_started_7d,lead,onsite_conversion.lead_grouped

# --- Safety ---
ENABLE_WRITES=false           # keep false until read-only tools look right
MAX_DAILY_BUDGET_INR=1000

# --- Guard rules (starting guesses, tune from your data) ---
TARGET_CPL_INR=60
RULE_NO_LEAD_SPEND_INR=900
RULE_CPL_MULTIPLIER=2
RULE_MAX_FREQUENCY=3
RULE_LEARNING_HOURS=48
RULE_LOOKBACK_DAYS=3

# --- HTTP server ---
PORT=3000
MCP_PATH_SECRET=              # long random string; endpoint becomes /mcp/<secret>

# --- Cron ---
CRON_AD_ACCOUNT_IDS=          # comma separated; defaults to META_AD_ACCOUNT_ID

# --- WhatsApp daily report (optional) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REPORT_TO=           # 91XXXXXXXXXX
WHATSAPP_TEMPLATE=            # approved template with 3 body params: spend, leads, CPL
WHATSAPP_TEMPLATE_LANG=en
